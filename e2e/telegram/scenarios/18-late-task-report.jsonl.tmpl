# Точечно проверяет поздний результат после auto-fail задачи дня.
# После появления task card выставь через control API 12:01 следующего локального дня и вызови tick.
{"id":"select_today","action":"select_chat","chat":"{{CHAT}}","message_thread_id":{{TODAY_THREAD_ID}}}
{"id":"open_add_task","action":"click_button","button_text":"➕ Добавить задачу","timeout_ms":60000}
{"id":"wait_task_prompt","action":"wait","timeout_ms":60000}
{"id":"send_task","action":"send_text","text":"Проверить поздний результат после автозакрытия"}
{"id":"wait_task_card","action":"assert_visible_text","text":"Проверить поздний результат после автозакрытия","timeout_ms":90000}
{"id":"wait_auto_fail_alert","action":"assert_visible_text","text":"Время вышло. Задача отмечена как невыполненная","timeout_ms":180000}
{"id":"assert_task_card_failed","action":"assert_visible_text","text":"не выполнил задачу дня","timeout_ms":60000}
{"id":"open_late_report","action":"click_button","button_text":"🏁 Результат","message_text":"Время вышло. Задача отмечена как невыполненная","timeout_ms":60000}
{"id":"assert_status_picker","action":"assert_visible_text","text":"Выбери итог дня","timeout_ms":60000}
{"id":"choose_done_result","action":"click_button","button_text":"✅ Выполнена","message_text":"Выбери итог дня","timeout_ms":60000}
{"id":"assert_report_prompt","action":"assert_visible_text","text":"Напиши результат одним сообщением","timeout_ms":60000}
{"id":"send_late_report","action":"send_text","text":"Результат записан после дедлайна без смены статуса."}
{"id":"assert_failed_card_with_report","action":"assert_visible_text","text":"Результат записан после дедлайна без смены статуса.","timeout_ms":90000}
{"id":"select_progress","action":"select_chat","chat":"{{CHAT}}","message_thread_id":{{PROGRESS_THREAD_ID}}}
{"id":"assert_auto_fail_kept","action":"assert_visible_text","text":"не выполнил задачу дня вовремя","timeout_ms":120000}
{"id":"assert_late_report_synced","action":"assert_visible_text","text":"Результат записан после дедлайна без смены статуса.","timeout_ms":120000}
